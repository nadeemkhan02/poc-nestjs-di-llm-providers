# Which registered vendor to use. Must match a name a provider registers
# itself under in LlmProviderRegistry (see src/llm/tokens/llm.tokens.ts).
LLM_PROVIDER=openai

# Placeholders only — this POC never makes a real API call, so any value works.
# Do NOT put real API keys here or in any committed file.
OPENAI_API_KEY=your-openai-api-key-placeholder
OPENAI_MODEL=gpt-4o-mini

DEEPSEEK_API_KEY=your-deepseek-api-key-placeholder
DEEPSEEK_MODEL=deepseek-chat

PORT=3000
